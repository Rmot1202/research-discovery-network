VITE_API_URL=http://127.0.0.1:8001

# PostgreSQL (set DATABASE_URL to enable the PostgreSQL database; otherwise local SQLite is used)
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=research_discovery
DATABASE_URL=postgresql+psycopg://research:replace-with-a-local-password@localhost:5432/research_discovery
PAPERS_DB=backend/data/papers.sqlite3

# Required for protected admin review endpoints. Generate a private random value locally.
ADMIN_API_TOKEN=replace-with-a-private-random-token

# OpenAI-compatible API settings for summaries and the research assistant.
# Local Ollama example: AI_BASE_URL=http://127.0.0.1:11434/v1, AI_CHAT_MODEL=llama3.1:8b, AI_EMBEDDING_MODEL=nomic-embed-text
# Keep the API key private in your local .env file.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# Paper scan for missing affiliations (optional). A free key gives the scan its own daily
# OpenAlex budget instead of sharing one with everyone on your network: https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Hosting: extra allowed browser origins for the API (comma-separated), only needed
# when the website is served from a different domain than the API.
CORS_ORIGINS=

# Publishing: "auto" makes new papers public right away (Featured = editor picks, then newest);
# "review" features only reviewer-approved papers (URD spec default).
PUBLISH_MODE=auto
# Research scope: blank or "all" = every arXiv CS category; "mvp" = AI/ML/NLP and related;
# or a list such as cs.AI,cs.LG,cs.CL
RESEARCH_SCOPE=
