{
  "projectType": "webapp",
  "setup": [],
  "assertions": [
    {
      "name": "typescript-no-emit",
      "kind": "process",
      "command": "/usr/local/bin/node",
      "args": [
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "production-build",
      "kind": "process",
      "command": "/usr/local/bin/node",
      "args": [
        "node_modules/vite/bin/vite.js",
        "build"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "home-page-serves",
      "kind": "http-probe",
      "startCommand": "/usr/local/bin/node",
      "startArgs": [
        "node_modules/vite/bin/vite.js",
        "--host",
        "127.0.0.1",
        "--port",
        "5174"
      ],
      "url": "http://127.0.0.1:5174/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
